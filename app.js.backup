'use strict';

// ============================================================================
// StorageManager Module
// ============================================================================
// Centralized Local Storage operations with error handling and JSON serialization.
// Provides a safe wrapper around the Local Storage API to handle quota errors,
// JSON parse failures, and unavailable storage (e.g., private browsing mode).
// ============================================================================

const StorageManager = (function() {
  // Storage key prefix to namespace dashboard data
  const STORAGE_PREFIX = 'dashboard_';
  
  /**
   * Check if Local Storage is available and functional
   * Handles cases where localStorage exists but is disabled (private browsing)
   * @returns {boolean} True if Local Storage is available and functional
   */
  function isAvailable() {
    try {
      const testKey = '__storage_test__';
      localStorage.setItem(testKey, testKey);
      localStorage.removeItem(testKey);
      return true;
    } catch (e) {
      console.warn('Local Storage is not available:', e.message);
      return false;
    }
  }
  
  /**
   * Get item from Local Storage with optional default value
   * @param {string} key - Storage key (without prefix)
   * @param {*} defaultValue - Value to return if key doesn't exist or on error
   * @returns {string|*} Stored value or defaultValue
   */
  function getItem(key, defaultValue = null) {
    try {
      const fullKey = STORAGE_PREFIX + key;
      const value = localStorage.getItem(fullKey);
      
      // Return default if key doesn't exist
      if (value === null) {
        return defaultValue;
      }
      
      return value;
    } catch (e) {
      console.error(`Error getting item "${key}" from Local Storage:`, e.message);
      return defaultValue;
    }
  }
  
  /**
   * Set item in Local Storage with error handling
   * @param {string} key - Storage key (without prefix)
   * @param {string} value - Value to store
   * @returns {boolean} True if successful, false on error
   */
  function setItem(key, value) {
    try {
      const fullKey = STORAGE_PREFIX + key;
      localStorage.setItem(fullKey, value);
      return true;
    } catch (e) {
      // Handle specific quota exceeded error
      if (e.name === 'QuotaExceededError') {
        console.error('Local Storage quota exceeded. Cannot save data.');
        // In a production app, you might show a user-friendly message here
        alert('Storage full. Please delete some data to continue.');
      } else {
        console.error(`Error setting item "${key}" in Local Storage:`, e.message);
        // Could be SecurityError in private browsing or other storage issues
        console.warn('Data could not be saved. Are you using private browsing?');
      }
      return false;
    }
  }
  
  /**
   * Remove item from Local Storage
   * @param {string} key - Storage key (without prefix)
   * @returns {boolean} True if successful, false on error
   */
  function removeItem(key) {
    try {
      const fullKey = STORAGE_PREFIX + key;
      localStorage.removeItem(fullKey);
      return true;
    } catch (e) {
      console.error(`Error removing item "${key}" from Local Storage:`, e.message);
      return false;
    }
  }
  
  /**
   * Get parsed JSON object from Local Storage
   * @param {string} key - Storage key (without prefix)
   * @param {*} defaultValue - Value to return if key doesn't exist or parse fails
   * @returns {Object|*} Parsed object or defaultValue
   */
  function getObject(key, defaultValue = null) {
    try {
      const fullKey = STORAGE_PREFIX + key;
      const json = localStorage.getItem(fullKey);
      
      // Return default if key doesn't exist
      if (json === null) {
        return defaultValue;
      }
      
      // Parse JSON with error handling
      try {
        const obj = JSON.parse(json);
        return obj;
      } catch (parseError) {
        console.error(`Error parsing JSON for key "${key}":`, parseError.message);
        console.warn(`Returning default value for "${key}"`);
        return defaultValue;
      }
    } catch (e) {
      console.error(`Error getting object "${key}" from Local Storage:`, e.message);
      return defaultValue;
    }
  }
  
  /**
   * Set object as JSON string in Local Storage
   * @param {string} key - Storage key (without prefix)
   * @param {Object} obj - Object to serialize and store
   * @returns {boolean} True if successful, false on error
   */
  function setObject(key, obj) {
    try {
      // Serialize object to JSON
      const json = JSON.stringify(obj);
      
      // Store using setItem (which handles quota errors)
      return setItem(key, json);
    } catch (e) {
      // JSON.stringify can throw on circular references or other issues
      console.error(`Error serializing object for key "${key}":`, e.message);
      return false;
    }
  }
  
  // Public API
  return {
    isAvailable,
    getItem,
    setItem,
    removeItem,
    getObject,
    setObject
  };
})();

// ============================================================================
// GreetingController Module
// ============================================================================
// Manages the real-time clock, date display, and personalized greetings.
// Updates time every second, displays hour-based greetings, and handles
// user name persistence with XSS protection via textContent.
// ============================================================================

const GreetingController = (function() {
  // Private state
  let userName = '';
  let clockInterval = null;
  
  // DOM element references (cached for performance)
  let greetingTextElement = null;
  let greetingDateElement = null;
  let greetingTimeElement = null;
  let userNameInputElement = null;
  
  /**
   * Initialize the greeting controller
   * Sets up DOM references, loads saved name, starts clock
   */
  function init() {
    // Cache DOM element references
    greetingTextElement = document.getElementById('greeting-text');
    greetingDateElement = document.getElementById('greeting-date');
    greetingTimeElement = document.getElementById('greeting-time');
    userNameInputElement = document.getElementById('user-name-input');
    
    // Load saved user name from storage
    userName = StorageManager.getItem('user_name', '');
    
    // Set input field value if name exists
    if (userNameInputElement && userName) {
      userNameInputElement.value = userName;
    }
    
    // Set up event listener for name changes
    if (userNameInputElement) {
      userNameInputElement.addEventListener('input', handleNameInput);
      userNameInputElement.addEventListener('blur', handleNameBlur);
    }
    
    // Initial update of time, date, and greeting
    updateTime();
    updateGreeting();
    
    // Start the clock (update every second)
    clockInterval = setInterval(updateTime, 1000);
  }
  
  /**
   * Update time display in HH:MM:SS format
   * Called every second by setInterval
   */
  function updateTime() {
    const now = new Date();
    
    // Format time as HH:MM:SS with zero-padding
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');
    const timeString = `${hours}:${minutes}:${seconds}`;
    
    // Update time display using textContent (XSS-safe)
    if (greetingTimeElement) {
      greetingTimeElement.textContent = timeString;
    }
    
    // Update date display using Intl.DateTimeFormat for localization
    if (greetingDateElement) {
      const dateFormatter = new Intl.DateTimeFormat('en-US', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      });
      greetingDateElement.textContent = dateFormatter.format(now);
    }
    
    // Update greeting based on current hour (may change during the day)
    updateGreeting();
  }
  
  /**
   * Update greeting based on current hour
   * Greeting logic:
   * - 05:00-10:59: "Good Morning"
   * - 11:00-16:59: "Good Afternoon"
   * - 17:00-20:59: "Good Evening"
   * - 21:00-04:59: "Good Night"
   */
  function updateGreeting() {
    const now = new Date();
    const hour = now.getHours();
    
    let greeting = '';
    
    // Determine greeting based on hour
    if (hour >= 5 && hour < 11) {
      greeting = 'Good Morning';
    } else if (hour >= 11 && hour < 17) {
      greeting = 'Good Afternoon';
    } else if (hour >= 17 && hour < 21) {
      greeting = 'Good Evening';
    } else {
      greeting = 'Good Night';
    }
    
    // Append user name if set
    if (userName) {
      greeting += ', ' + userName;
    }
    
    // Update greeting display using textContent (XSS-safe)
    if (greetingTextElement) {
      greetingTextElement.textContent = greeting;
    }
  }
  
  /**
   * Handle user name input changes (real-time update)
   * @param {Event} event - Input event
   */
  function handleNameInput(event) {
    // Sanitize input to prevent XSS
    const sanitizedName = sanitizeInput(event.target.value);
    
    // Update internal state
    userName = sanitizedName;
    
    // Update greeting immediately
    updateGreeting();
  }
  
  /**
   * Handle user name input blur (save to storage)
   * @param {Event} event - Blur event
   */
  function handleNameBlur(event) {
    // Sanitize and trim input
    const sanitizedName = sanitizeInput(event.target.value);
    
    // Update the input field with sanitized value
    event.target.value = sanitizedName;
    
    // Save to storage
    setUserName(sanitizedName);
  }
  
  /**
   * Sanitize user input to prevent XSS
   * @param {string} input - Raw user input
   * @returns {string} Sanitized input
   */
  function sanitizeInput(input) {
    if (!input) return '';
    
    // Trim whitespace
    let sanitized = input.trim();
    
    // Remove any HTML tags (defensive layer)
    sanitized = sanitized.replace(/<[^>]*>/g, '');
    
    // Limit length (50 characters as per requirements)
    sanitized = sanitized.substring(0, 50);
    
    return sanitized;
  }
  
  /**
   * Set user name and save to storage
   * @param {string} name - User's name
   */
  function setUserName(name) {
    // Sanitize input
    userName = sanitizeInput(name);
    
    // Save to Local Storage
    StorageManager.setItem('user_name', userName);
    
    // Update greeting display
    updateGreeting();
  }
  
  /**
   * Get current user name
   * @returns {string} Current user name
   */
  function getUserName() {
    return userName;
  }
  
  /**
   * Stop the clock interval (cleanup)
   */
  function destroy() {
    if (clockInterval) {
      clearInterval(clockInterval);
      clockInterval = null;
    }
  }
  
  // Public API
  return {
    init,
    updateTime,
    updateGreeting,
    setUserName,
    getUserName,
    destroy
  };
})();

// ============================================================================
// TimerController Module
// ============================================================================
// Manages the Pomodoro countdown timer with start/stop/reset functionality.
// Handles timer state management, display updates, completion notifications,
// and state persistence for page refresh recovery.
// ============================================================================

const TimerController = (function() {
  // Private state
  let durationMinutes = 25;      // Default or custom duration
  let remainingSeconds = 1500;   // Current countdown value (25 minutes = 1500 seconds)
  let isRunning = false;         // Timer active state
  let intervalId = null;         // setInterval reference
  
  // DOM element references (cached for performance)
  let timerDisplayElement = null;
  let startButtonElement = null;
  let stopButtonElement = null;
  let resetButtonElement = null;
  let durationInputElement = null;
  let setDurationButtonElement = null;
  let durationErrorElement = null;
  
  /**
   * Initialize the timer controller
   * Sets up DOM references, loads saved duration, restores timer state
   */
  function init() {
    // Cache DOM element references
    timerDisplayElement = document.getElementById('timer-display');
    startButtonElement = document.getElementById('timer-start');
    stopButtonElement = document.getElementById('timer-stop');
    resetButtonElement = document.getElementById('timer-reset');
    durationInputElement = document.getElementById('timer-duration-input');
    setDurationButtonElement = document.getElementById('timer-set-duration');
    durationErrorElement = document.getElementById('timer-duration-error');
    
    // Load saved duration from storage (default 25 if not set)
    const savedDuration = StorageManager.getItem('timer_duration', '25');
    durationMinutes = parseInt(savedDuration, 10);
    
    // Initialize remaining seconds based on duration
    remainingSeconds = durationMinutes * 60;
    
    // Set up event listeners
    if (startButtonElement) {
      startButtonElement.addEventListener('click', start);
    }
    if (stopButtonElement) {
      stopButtonElement.addEventListener('click', stop);
    }
    if (resetButtonElement) {
      resetButtonElement.addEventListener('click', reset);
    }
    
    // Initial display update
    updateDisplay();
    
    // Request notification permission on initialization (non-blocking)
    requestNotificationPermission();
  }
  
  /**
   * Format seconds as MM:SS with zero-padding
   * @param {number} totalSeconds - Total seconds to format
   * @returns {string} Formatted time string (MM:SS)
   */
  function formatTime(totalSeconds) {
    const minutes = Math.floor(totalSeconds / 60);
    const seconds = totalSeconds % 60;
    
    // Zero-pad minutes and seconds
    const minutesStr = String(minutes).padStart(2, '0');
    const secondsStr = String(seconds).padStart(2, '0');
    
    return `${minutesStr}:${secondsStr}`;
  }
  
  /**
   * Update timer display
   */
  function updateDisplay() {
    if (timerDisplayElement) {
      timerDisplayElement.textContent = formatTime(remainingSeconds);
    }
  }
  
  /**
   * Update button states based on timer running state
   */
  function updateButtonStates() {
    if (startButtonElement) {
      // Disable Start button while timer is running
      startButtonElement.disabled = isRunning;
    }
  }
  
  /**
   * Start the countdown timer
   */
  function start() {
    // Prevent double-start
    if (isRunning) {
      return;
    }
    
    // If timer is at 0, reset to duration first
    if (remainingSeconds <= 0) {
      reset();
    }
    
    // Set running state
    isRunning = true;
    
    // Update button states (disable Start button)
    updateButtonStates();
    
    // Start countdown interval (decrement every second)
    intervalId = setInterval(tick, 1000);
  }
  
  /**
   * Stop (pause) the countdown timer
   */
  function stop() {
    // Clear interval
    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
    }
    
    // Set running state
    isRunning = false;
    
    // Update button states (enable Start button)
    updateButtonStates();
  }
  
  /**
   * Reset timer to configured duration
   */
  function reset() {
    // Stop timer if running
    stop();
    
    // Reset remaining seconds to duration
    remainingSeconds = durationMinutes * 60;
    
    // Update display
    updateDisplay();
  }
  
  /**
   * Timer tick function (called every second)
   * Decrements remaining seconds and handles completion
   */
  function tick() {
    // Decrement remaining seconds
    remainingSeconds--;
    
    // Update display
    updateDisplay();
    
    // Check if timer has completed
    if (remainingSeconds <= 0) {
      // Stop timer
      stop();
      
      // Show completion notification
      showCompletionNotification();
    }
  }
  
  /**
   * Request notification permission from the user
   * Non-blocking - only requests if not already granted or denied
   */
  function requestNotificationPermission() {
    // Check if Notification API is supported
    if (!('Notification' in window)) {
      console.warn('Notifications are not supported in this browser');
      return;
    }
    
    // Request permission if not already granted or denied
    if (Notification.permission === 'default') {
      Notification.requestPermission().then(permission => {
        if (permission === 'granted') {
          console.log('Notification permission granted');
        } else {
          console.log('Notification permission denied');
        }
      }).catch(error => {
        console.error('Error requesting notification permission:', error);
      });
    }
  }
  
  /**
   * Show completion notification when timer reaches 0
   */
  function showCompletionNotification() {
    // Check if Notification API is supported
    if (!('Notification' in window)) {
      // Fallback: use browser alert
      alert('Timer completed! ⏰');
      return;
    }
    
    // Check if permission is granted
    if (Notification.permission === 'granted') {
      // Create notification
      const notification = new Notification('Timer Completed! ⏰', {
        body: 'Your focus session has ended. Time for a break!',
        icon: '⏰',
        requireInteraction: false,
        tag: 'timer-completion' // Prevent duplicate notifications
      });
      
      // Auto-close notification after 5 seconds
      setTimeout(() => {
        notification.close();
      }, 5000);
    } else {
      // Fallback: use browser alert
      alert('Timer completed! ⏰');
    }
  }
  
  /**
   * Get current duration in minutes
   * @returns {number} Current timer duration in minutes
   */
  function getDuration() {
    return durationMinutes;
  }
  
  // Public API
  return {
    init,
    start,
    stop,
    reset,
    getDuration
  };
})();

// ============================================================================
// AppInitializer Module
// ============================================================================
// Bootstrap the application and coordinate module initialization.
// Checks localStorage availability, initializes modules in sequence,
// and handles DOMContentLoaded event.
// ============================================================================

const AppInitializer = (function() {
  /**
   * Initialize the application
   * Called immediately when script loads
   */
  function init() {
    // Check localStorage availability
    if (!StorageManager.isAvailable()) {
      console.warn('Local Storage is not available. Data will not persist.');
      // Application still functions, but data is lost on refresh
    }
    
    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeApp);
    } else {
      // DOM is already ready
      initializeApp();
    }
  }
  
  /**
   * Initialize all application modules
   * Called after DOM is ready
   */
  function initializeApp() {
    try {
      // Initialize GreetingController (starts the clock)
      GreetingController.init();
      
      // Initialize TimerController
      TimerController.init();
      
      console.log('Application initialized successfully');
    } catch (error) {
      console.error('Error initializing application:', error);
      // Display user-friendly error message
      const errorMessage = 'Failed to initialize application. Please refresh the page.';
      alert(errorMessage);
    }
  }
  
  // Public API
  return {
    init
  };
})();

// ============================================================================
// Application Bootstrap
// ============================================================================
// Initialize the application immediately when script loads
AppInitializer.init();
